---
import Base from '../layouts/Base.astro'
import { url } from '../url'
---
<Base noindex title="Page not found" description="This page does not exist. Start from the docs, the playground or the comparison.">
  <main class="mx-auto max-w-2xl px-6 py-24">
    <h1 class="text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-4 text-gray-600 dark:text-gray-300">Nothing lives at this address. Try the <a class="text-accent underline" href={url('/')}>front page</a>, the <a class="text-accent underline" href={url('/guide/handling-errors/')}>docs</a> or the <a class="text-accent underline" href={url('/playground/')}>playground</a>.</p>
  </main>
</Base>
