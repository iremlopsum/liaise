---
// The front page is the intro (components/Intro.astro). A browser that finished or skipped it
// (intro/flag.ts) goes straight to Quick start: the head script runs before anything paints, and a
// storage error shows the intro. /intro/ is the same page without the redirect. Back (or Forward)
// onto this page doesn't redirect: a page the back/forward cache didn't keep runs the script again,
// and going on to Quick start would undo the reader's Back. The redirect carries where the visit came
// from, since Quick start's referrer is then this page: `via=front`, the referring site's origin as
// `r` (only another site's), and this address's ref and utm tags. The collector reads and removes
// via and r (analytics/page.ts, analytics/index.ts).
import Base from '../layouts/Base.astro'
import Intro from '../components/Intro.astro'
import { url } from '../url'
import { INTRO_KEY } from '../intro/flag'

const to = url('/start/quick-start/')
---
<Base intro="front" description="Type-safe REST and GraphQL on plain fetch. Every call returns { data, error }, so nothing throws.">
  <Fragment slot="head">
    <script is:inline define:vars={{ key: INTRO_KEY, to }}>
      try {
        const nav = typeof performance === 'undefined' ? undefined : performance.getEntriesByType?.('navigation')[0]
        if (nav?.type !== 'back_forward' && localStorage.getItem(key)) {
          let r = ''
          try { const o = new URL(document.referrer).origin; if (o !== location.origin) r = '&r=' + encodeURIComponent(o) } catch {}
          const q = new URLSearchParams(location.search)
          const other = ['ref', 'utm_source', 'utm_medium', 'utm_campaign'].filter((k) => q.has(k)).map((k) => '&' + k + '=' + encodeURIComponent(q.get(k))).join('')
          location.replace(to + '?via=front' + r + other)
        }
      } catch {}
    </script>
  </Fragment>
  <Intro />
</Base>
